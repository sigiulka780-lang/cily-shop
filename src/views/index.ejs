<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= siteName %> - <%= siteDesc %></title>
  <meta name="description" content="<%= siteDesc %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
</head>
<body>
  <div class="bg-grid"></div>
  <div class="bg-glow"></div>
  
  <header class="header">
    <nav class="nav container">
      <a href="/" class="logo" aria-label="Cily Home">
        <svg class="logo-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="currentColor"/>
          <path d="M8 16L14 22L24 10" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="logo-text"><%= siteName %></span>
      </a>
      <div class="nav-links">
        <a href="#features" class="nav-link">Функции</a>
        <a href="#pricing" class="nav-link">Цены</a>
        <a href="#faq" class="nav-link">FAQ</a>
        <a href="https://t.me/CilySupport" target="_blank" rel="noopener" class="nav-link nav-link--telegram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-2.13c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12c0-5.52-4.48-10-10-10z"/></svg>
          Поддержка
        </a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="pulse"></span>
            <span>Обновлено: 23.10.2026</span>
            <span>Статус: <strong class="status-undetected">UNDETECTED</strong></span>
          </div>
          <h1 class="hero-title">
            <%= siteName %>
            <span class="hero-sub">CS2 External Cheat</span>
          </h1>
          <p class="hero-desc">
            Профессиональный чит для Counter-Strike 2 с мощным аимботом, ESP, скинченджером и надежной защитой от VAC.
            Автоматическая выдача ключей после оплаты через СБП Сбербанк.
          </p>
          <div class="hero-actions">
            <a href="#pricing" class="btn btn--primary btn--large">Купить подписку</a>
            <a href="https://t.me/CilySupport" target="_blank" rel="noopener" class="btn btn--ghost btn--large">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-2.13c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12c0-5.52-4.48-10-10-10z"/></svg>
              Поддержка
            </a>
          </div>
          <div class="hero-stats">
            <div class="stat">
              <span class="stat-value">99.9%</span>
              <span class="stat-label">Uptime</span>
            </div>
            <div class="stat">
              <span class="stat-value">2000+</span>
              <span class="stat-label">Users</span>
            </div>
            <div class="stat">
              <span class="stat-value">0</span>
              <span class="stat-label">Bans</span>
            </div>
          </div>
        </div>
        <div class="hero-visual">
          <div class="loader-preview">
            <div class="loader-header">
              <div class="loader-dots">
                <span></span><span></span><span></span>
              </div>
              <span class="loader-title">celerity-loader.exe</span>
            </div>
            <div class="loader-body">
              <div class="loader-field">
                <label>License Key</label>
                <input type="text" value="CILY-XXXX-XXXX-XXXX-XXXX" readonly>
              </div>
              <div class="loader-field">
                <label>Target Process</label>
                <input type="text" value="cs2.exe" readonly>
              </div>
              <div class="loader-status status-active">
                <span class="status-dot"></span>
                <span>License Valid</span>
              </div>
              <button class="btn btn--inject">INJECT</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="features">
      <div class="container">
        <header class="section-header">
          <h2>Возможности</h2>
          <p>Всё необходимое для доминирования в матче</p>
        </header>
        <div class="features-grid">
          <article class="feature-card">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
            </div>
            <h3>Legit Aimbot</h3>
            <p>Плавная наведка с настройкой FOV, Smooth, RCS. Режимы: Hold, Toggle, AlwaysOn. Поддержка скрытого аимбота.</p>
          </article>
          <article class="feature-card">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5l-5 5-5-5"/></svg>
            </div>
            <h3>Triggerbot</h3>
            <p>Мгновенный выстрел при наведении на врага. Настраиваемая задержка, фильтр по хитбоксам, работа через стены.</p>
          </article>
          <article class="feature-card">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 16l4.586-4.586a2 2 0 0 1 2.828 0L16 16m-2-2l1.586-1.586a2 2 0 0 1 2.828 0L20 14m-6-6h.01M6 20h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z"/></svg>
            </div>
            <h3>Bunny Hop</h3>
            <p>Автоматические идеальные прыжки. Режим AlwaysOn — не требует удержания клавиши. Работает на всех картах.</p>
          </article>
          <article class="feature-card">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3>ESP / Visuals</h3>
            <p>Box ESP, Skeleton, Health, Armor, Weapon, Ammo, Distance. Team check, Visible check, настройка цветов.</p>
          </article>
          <article class="feature-card">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Skin Changer</h3>
            <p>Смена скинов на любое оружие и ножи. Инвентарь с поиском, статтрак, наклейки. Работает в лобби и в матче.</p>
          </article>
          <article class="feature-card">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M12 6v12M6 12h12"/></svg>
            </div>
            <h3>Config System</h3>
            <p>Сохранение/загрузка конфигов, облачная синхронизация, дефолтный конфиг с оптимальными настройками из коробки.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="pricing">
      <div class="container">
        <header class="section-header">
          <h2>Подписка</h2>
          <p>Выбери способ оплаты: авто (СБП/карта) или ручная (перевод на карту)</p>
        </header>
        <div class="pricing-grid">
          <% plans.forEach((plan, index) => { %>
          <article class="pricing-card <%= index === 1 ? 'popular' : '' %>">
            <% if (index === 1) { %>
            <div class="popular-badge">Популярный</div>
            <% } %>
            <div class="plan-header">
              <h3><%= plan.name %></h3>
              <div class="plan-price">
                <span class="amount"><%= plan.price_rub.toLocaleString('ru-RU') %></span>
                <span class="period">₽</span>
              </div>
              <p class="plan-duration"><%= plan.duration_days %> дней</p>
            </div>
            <ul class="plan-features">
              <% JSON.parse(plan.features).forEach(feature => { %>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <%= feature %>
              </li>
              <% }) %>
            </ul>
            <% if (plan.id.startsWith('manual_')) { %>
              <a href="/payment/manual/<%= plan.id %>" class="btn btn--ghost btn--block" style="border-color: var(--accent); color: var(--accent);" <%= maintenance ? 'style="pointer-events:none;opacity:0.5;"' : '' %>>
                <%= maintenance ? 'Тех. работы' : 'Оплатить вручную' %>
              </a>
            <% } else { %>
              <button 
                class="btn btn--primary btn--block btn-buy" 
                data-plan-id="<%= plan.id %>"
                data-plan-name="<%= plan.name %>"
                data-plan-price="<%= plan.price_rub %>"
                <%= maintenance ? 'disabled' : '' %>
              >
                <%= maintenance ? 'Тех. работы' : 'Купить сейчас (СБП/Карта)' %>
              </button>
            <% } %>
          </article>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="howitworks">
      <div class="container">
        <header class="section-header">
          <h2>Как это работает</h2>
          <p>3 шага до игры</p>
        </header>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <h3>Выбери тариф</h3>
            <p>Оплати через СБП Сбербанк — деньги приходят мгновенно</p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <h3>Получи ключ</h3>
            <p>Лицензионный ключ придёт на email и отобразится на сайте</p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <h3>Играй</h3>
            <p>Скачай лоадер, введи ключ, нажми INJECT — и вперёд в матч</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq">
      <div class="container">
        <header class="section-header">
          <h2>Частые вопросы</h2>
        </header>
        <div class="faq-list">
          <details class="faq-item">
            <summary>Как происходит оплата и выдача ключа?</summary>
            <p>После оплаты через СБП Сбербанк (YooKassa) ключ генерируется автоматически, активируется на сервере лицензий и приходит на ваш email. Весь процесс занимает 10-30 секунд.</p>
          </details>
          <details class="faq-item">
            <summary>Нужен ли запуск от администратора?</summary>
            <p>Да, CS2 и Steam обычно запущены с повышенными правами. Лоадер требует UAC для инжекта в процесс игры. При первом запуске подтвердите запрос Windows.</p>
          </details>
          <details class="faq-item">
            <summary>Что такое HWID и могу ли я играть с другого ПК?</summary>
            <p>HWID — уникальный идентификатор вашего компьютера. Ключ привязывается к HWID при первом запуске. Сменить привязку можно через поддержку (раз в 7 дней бесплатно).</p>
          </details>
          <details class="faq-item">
            <summary>Есть ли баны за использование?</summary>
            <p>Чит использует ручной маппинг DLL, проверку подписи payload, анти-отладку и heartbeat-систему. На данный момент банов нет (undetected), но 100% гарантии не существует — пользуйтесь на свой страх и риск.</p>
          </details>
          <details class="faq-item">
            <summary>Как обновить чит?</summary>
            <p>Лоадер сам проверяет обновления при запуске. Если вышла новая версия — он скачает и применит её автоматически. Вам не нужно перескачивать файл вручную.</p>
          </details>
          <details class="faq-item">
            <summary>Можно ли вернуть деньги?</summary>
            <p>Возврат возможен в течение 24 часов после покупки, если ключ не активировался (не было инжекта). Обратитесь в поддержку @CilySupport.</p>
          </details>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo">
            <svg class="logo-icon" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="currentColor"/><path d="M8 16L14 22L24 10" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="logo-text"><%= siteName %></span>
          </a>
          <p>Лучший CS2 чит с 2024 года. Надёжность, безопасность, поддержка.</p>
        </div>
        <nav class="footer-nav">
          <h4>Продукт</h4>
          <a href="#features">Функции</a>
          <a href="#pricing">Цены</a>
          <a href="#faq">FAQ</a>
        </nav>
        <nav class="footer-nav">
          <h4>Поддержка</h4>
          <a href="https://t.me/CilySupport" target="_blank" rel="noopener">Telegram</a>
          <a href="https://discord.gg/cily" target="_blank" rel="noopener">Discord</a>
          <a href="#">Инструкция</a>
        </nav>
        <nav class="footer-nav">
          <h4>Юридическое</h4>
          <a href="#">ToS</a>
          <a href="#">Privacy Policy</a>
          <a href="#">Refund Policy</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2024-2026 <%= siteName %>. Не официальный продукт Valve. Использование на свой страх и риск.</p>
      </div>
    </div>
  </footer>

  <!-- Payment Modal -->
  <dialog id="payment-modal" class="modal">
    <form method="dialog" class="modal-content">
      <button class="modal-close" value="cancel" aria-label="Close">&times;</button>
      <h3 id="modal-title">Оплата подписки</h3>
      <p id="modal-subtitle" class="modal-subtitle"></p>
      <div class="form-group">
        <label for="email">Email для получения ключа</label>
        <input type="email" id="email" name="email" required placeholder="your@email.com" autocomplete="email">
      </div>
      <button type="submit" class="btn btn--primary btn--block" id="pay-btn">Оплатить <span id="pay-amount"></span> ₽</button>
      <p class="modal-note">После оплаты ключ придёт на email и отобразится здесь</p>
    </form>
  </dialog>

  <script src="/js/main.js"></script>
</body>
</html>