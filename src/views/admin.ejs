<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админ панель - <%= siteName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .admin-container { padding: 100px 0 60px; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px; }
    .stat-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; }
    .stat-card h3 { font-size: 0.8rem; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
    .stat-card .value { font-family: var(--font-mono); font-size: 2rem; font-weight: 700; color: var(--accent); }
    .table-container { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin-bottom: 32px; }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    th, td { padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--border); }
    th { background: var(--bg-elevated); font-weight: 600; color: var(--fg-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; }
    tr:last-child td { border-bottom: none; }
    .badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; }
    .badge-active { background: var(--accent-dim); color: var(--accent); border: 1px solid var(--accent); }
    .badge-pending { background: rgba(255,165,2,0.1); color: var(--warning); border: 1px solid var(--warning); }
    .badge-expired { background: rgba(136,136,153,0.1); color: var(--fg-muted); border: 1px solid var(--border); }
    .badge-banned { background: rgba(255,71,87,0.1); color: var(--danger); border: 1px solid var(--danger); }
    .badge-succeeded { background: var(--accent-dim); color: var(--accent); }
    .badge-canceled { background: rgba(255,71,87,0.1); color: var(--danger); }
    .btn-sm { padding: 6px 12px; font-size: 0.75rem; }
    .action-btn { margin-right: 8px; }
    .license-key { font-family: var(--font-mono); font-size: 0.8rem; }
    .modal-admin { max-width: 400px; }
    .modal-admin .form-group { margin-bottom: 16px; }
    .modal-admin label { display: block; margin-bottom: 6px; font-size: 0.8rem; color: var(--fg-muted); }
    .modal-admin input { width: 100%; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 10px 12px; color: var(--fg); }
    .modal-admin .btn { width: 100%; margin-top: 8px; }
  </style>
</head>
<body>
  <div class="bg-grid"></div>
  <div class="bg-glow"></div>
  
  <header class="header">
    <nav class="nav container">
      <a href="/" class="logo">
        <svg class="logo-icon" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="currentColor"/><path d="M8 16L14 22L24 10" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="logo-text"><%= siteName %> Admin</span>
      </a>
      <a href="/" class="nav-link" target="_blank">Сайт</a>
    </nav>
  </header>

  <main class="admin-container">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
        <h1>Панель администратора</h1>
        <button class="btn btn--primary" onclick="openCreateLicenseModal()">+ Выдать ключ вручную</button>
      </div>
      
      <div class="stats-grid">
        <div class="stat-card"><h3>Всего лицензий</h3><div class="value"><%= stats.totalLicenses %></div></div>
        <div class="stat-card"><h3>Активных</h3><div class="value"><%= stats.activeLicenses %></div></div>
        <div class="stat-card"><h3>Истекших</h3><div class="value"><%= stats.expiredLicenses %></div></div>
        <div class="stat-card"><h3>Забаненных</h3><div class="value"><%= stats.bannedLicenses %></div></div>
        <div class="stat-card"><h3>Выручка</h3><div class="value"><%= stats.totalRevenue.toLocaleString('ru-RU') %> ₽</div></div>
        <div class="stat-card"><h3>Ожидают оплаты</h3><div class="value"><%= stats.pendingPayments %></div></div>
      </div>
      
      <!-- Licenses Table -->
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Ключ</th>
              <th>Тариф</th>
              <th>Email</th>
              <th>Статус</th>
              <th>HWID</th>
              <th>Создана</th>
              <th>Истекает</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% recentLicenses.forEach(l => { %>
            <tr>
              <td><span class="license-key"><%= l.id %></span></td>
              <td><%= l.plan_name %></td>
              <td><%= l.email || '—' %></td>
              <td><span class="badge badge-<%= l.status %>"><%= l.status %></span></td>
              <td><%= l.hwid ? '<span class="license-key">' + l.hwid.substring(0,16) + '...</span>' : '—' %></td>
              <td><%= new Date(l.created_at).toLocaleDateString('ru-RU') %></td>
              <td><%= new Date(l.expires_at).toLocaleDateString('ru-RU') %></td>
              <td>
                <% if (l.status === 'active') { %>
                <button class="btn btn--ghost btn-sm action-btn" onclick="openBanModal('<%= l.id %>')">Забанить</button>
                <button class="btn btn--ghost btn-sm action-btn" onclick="openResetHwidModal('<%= l.id %>')">Сбросить HWID</button>
                <button class="btn btn--ghost btn-sm action-btn" onclick="openExtendModal('<%= l.id %>')">Продлить</button>
                <% } else if (l.status === 'banned') { %>
                <button class="btn btn--primary btn-sm action-btn" onclick="openUnbanModal('<%= l.id %>')">Разбанить</button>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      
      <!-- Payments Table -->
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Лицензия</th>
              <th>Тариф</th>
              <th>Сумма</th>
              <th>Email</th>
              <th>Статус</th>
              <th>Способ</th>
              <th>Дата</th>
            </tr>
          </thead>
          <tbody>
            <% recentPayments.forEach(p => { %>
            <tr>
              <td><%= p.id.substring(0,12) %>...</td>
              <td><%= p.license_id ? p.license_id.substring(0,12) + '...' : '—' %></td>
              <td><%= p.plan_id %></td>
              <td><%= p.amount_rub.toLocaleString('ru-RU') %> ₽</td>
              <td><%= p.email %></td>
              <td><span class="badge badge-<%= p.status %>"><%= p.status %></span></td>
              <td><%= p.payment_method || '—' %></td>
              <td><%= new Date(p.created_at).toLocaleString('ru-RU') %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Modals -->
  <dialog id="ban-modal" class="modal modal-admin">
    <form method="dialog" class="modal-content">
      <button class="modal-close" value="cancel">&times;</button>
      <h3>Забанить лицензию</h3>
      <p class="modal-subtitle">Ключ: <span id="ban-key" class="license-key"></span></p>
      <input type="hidden" id="ban-license-id">
      <div class="form-group">
        <label>Причина</label>
        <input type="text" id="ban-reason" placeholder="Нарушение ToS, чит обнаружен и т.д." required>
      </div>
      <div style="display: flex; gap: 8px;">
        <button type="submit" class="btn btn--primary" style="background: var(--danger);" onclick="confirmBan()">Забанить</button>
        <button type="button" class="btn btn--ghost" value="cancel">Отмена</button>
      </div>
    </form>
  </dialog>

  <dialog id="unban-modal" class="modal modal-admin">
    <form method="dialog" class="modal-content">
      <button class="modal-close" value="cancel">&times;</button>
      <h3>Разбанить лицензию</h3>
      <p class="modal-subtitle">Ключ: <span id="unban-key" class="license-key"></span></p>
      <input type="hidden" id="unban-license-id">
      <div style="display: flex; gap: 8px;">
        <button type="submit" class="btn btn--primary" onclick="confirmUnban()">Разбанить</button>
        <button type="button" class="btn btn--ghost" value="cancel">Отмена</button>
      </div>
    </form>
  </dialog>

  <dialog id="reset-hwid-modal" class="modal modal-admin">
    <form method="dialog" class="modal-content">
      <button class="modal-close" value="cancel">&times;</button>
      <h3>Сбросить HWID</h3>
      <p class="modal-subtitle">Ключ: <span id="rhw-key" class="license-key"></span></p>
      <p class="modal-subtitle" style="color: var(--warning);">Пользователь сможет привязать ключ к новому ПК</p>
      <input type="hidden" id="rhw-license-id">
      <div style="display: flex; gap: 8px;">
        <button type="submit" class="btn btn--primary" onclick="confirmResetHwid()">Сбросить</button>
        <button type="button" class="btn btn--ghost" value="cancel">Отмена</button>
      </div>
    </form>
  </dialog>

  <dialog id="extend-modal" class="modal modal-admin">
    <form method="dialog" class="modal-content">
      <button class="modal-close" value="cancel">&times;</button>
      <h3>Продлить подписку</h3>
      <p class="modal-subtitle">Ключ: <span id="ext-key" class="license-key"></span></p>
      <input type="hidden" id="ext-license-id">
      <div class="form-group">
        <label>Дней для добавления</label>
        <input type="number" id="ext-days" min="1" max="365" value="30" required>
      </div>
      <div style="display: flex; gap: 8px;">
        <button type="submit" class="btn btn--primary" onclick="confirmExtend()">Продлить</button>
        <button type="button" class="btn btn--ghost" value="cancel">Отмена</button>
      </div>
    </form>
  </dialog>

  <dialog id="create-license-modal" class="modal modal-admin">
    <form method="dialog" class="modal-content">
      <button class="modal-close" value="cancel">&times;</button>
      <h3>Выдать ключ вручную</h3>
      <p class="modal-subtitle">Для ручных оплат / компенсаций / тестов</p>
      <div class="form-group">
        <label>Email покупателя</label>
        <input type="email" id="cl-email" placeholder="buyer@email.com" required autocomplete="email">
      </div>
      <div class="form-group">
        <label>Тариф</label>
        <select id="cl-plan" required>
          <% plans.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.name %> — <%= p.price_rub %>₽ / <%= p.duration_days %>д</option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Дней (опционально, перезапишет тариф)</label>
        <input type="number" id="cl-days" min="1" max="365" placeholder="Оставь пустым для тарифа по умолчанию">
      </div>
      <div style="display: flex; gap: 8px;">
        <button type="submit" class="btn btn--primary" onclick="confirmCreateLicense()">Создать ключ</button>
        <button type="button" class="btn btn--ghost" value="cancel">Отмена</button>
      </div>
    </form>
  </dialog>

  <script>
    function openCreateLicenseModal() {
      document.getElementById('cl-email').value = '';
      document.getElementById('cl-days').value = '';
      document.getElementById('create-license-modal').showModal();
    }
    function openBanModal(key) {
      document.getElementById('ban-key').textContent = key;
      document.getElementById('ban-license-id').value = key;
      document.getElementById('ban-reason').value = '';
      document.getElementById('ban-modal').showModal();
    }
    function openUnbanModal(key) {
      document.getElementById('unban-key').textContent = key;
      document.getElementById('unban-license-id').value = key;
      document.getElementById('unban-modal').showModal();
    }
    function openResetHwidModal(key) {
      document.getElementById('rhw-key').textContent = key;
      document.getElementById('rhw-license-id').value = key;
      document.getElementById('reset-hwid-modal').showModal();
    }
    function openExtendModal(key) {
      document.getElementById('ext-key').textContent = key;
      document.getElementById('ext-license-id').value = key;
      document.getElementById('extend-modal').showModal();
    }
    
    async function confirmBan() {
      const key = document.getElementById('ban-license-id').value;
      const reason = document.getElementById('ban-reason').value;
      await fetch(`/admin/license/${key}/ban`, { method: 'POST' });
      location.reload();
    }
    async function confirmUnban() {
      const key = document.getElementById('unban-license-id').value;
      await fetch(`/admin/license/${key}/unban`, { method: 'POST' });
      location.reload();
    }
    async function confirmResetHwid() {
      const key = document.getElementById('rhw-license-id').value;
      await fetch(`/admin/license/${key}/reset-hwid`, { method: 'POST' });
      location.reload();
    }
    async function confirmExtend() {
      const key = document.getElementById('ext-license-id').value;
      const days = parseInt(document.getElementById('ext-days').value);
      await fetch(`/admin/license/${key}/extend`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ days })
      });
      location.reload();
    }
    async function confirmCreateLicense() {
      const email = document.getElementById('cl-email').value;
      const plan_id = document.getElementById('cl-plan').value;
      const days = document.getElementById('cl-days').value ? parseInt(document.getElementById('cl-days').value) : null;
      
      if (!email || !email.includes('@')) {
        alert('Введите корректный email');
        return;
      }
      
      const res = await fetch('/admin/license/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ plan_id, email, days })
      });
      
      const data = await res.json();
      if (data.success) {
        alert(`Ключ создан: ${data.licenseKey}\nТариф: ${data.plan}\nДействует до: ${new Date(data.expiresAt).toLocaleString('ru-RU')}`);
        location.reload();
      } else {
        alert('Ошибка: ' + (data.error || 'Неизвестная ошибка'));
      }
    }
    
    // Close modals on backdrop click
    document.querySelectorAll('.modal').forEach(m => {
      m.addEventListener('click', e => { if (e.target === m) m.close(); });
    });
  </script>
</body>
</html>