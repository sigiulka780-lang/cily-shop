# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=cily-super-secret-change-in-production

# Database
DB_PATH=./database/cily.db

# YooKassa (СБП Сбербанк) — для авто-оплаты
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_WEBHOOK_SECRET=your_webhook_secret

# License Server (your Celerity license server)
LICENSE_SERVER_URL=http://localhost:8443
LICENSE_SERVER_API_KEY=your_admin_api_key

# Frontend URL (for redirects after payment)
FRONTEND_URL=http://localhost:3000

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH= # generate with: node -e "console.log(require('crypto').createHash('sha256').update('your_password').digest('hex'))"

# Manual Payment Card Details (для ручной оплаты по номеру карты)
# ОБЯЗАТЕЛЬНО ИЗМЕНИ НА СВОИ РЕКВИЗИТЫ!
MANUAL_CARD_NUMBER=2200 1234 5678 9012
MANUAL_CARD_HOLDER=IVAN IVANOV
MANUAL_CARD_BANK=Сбербанк